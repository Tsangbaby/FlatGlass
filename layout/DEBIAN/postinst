#!/bin/sh
set -e
case "${DPKG_MAINTSCRIPT_ARCH:-}" in
  iphoneos-arm64e) prefix= ;; # RootHide bootstrap tools already use jbroot-relative paths.
  iphoneos-arm64) prefix=/var/jb ;;
  iphoneos-arm)   prefix= ;;
  *) printf '%s\n' 'FlatGlass: unsupported package architecture' >&2; exit 1 ;;
esac
PATH=/usr/bin:/bin:/usr/sbin:/sbin
if [ -n "$prefix" ]; then PATH="$prefix/usr/bin:$prefix/bin:$PATH"; fi
export PATH

fgd_install_sample() {
  [ "$DPKG_MAINTSCRIPT_ARCH" = iphoneos-arm64e ] || return 0
  /usr/libexec/flatglassdiag "$@" >/dev/null 2>&1 ||
    printf '%s\n' 'FlatGlass diagnostic install marker unavailable' >&2
}

fgd_install_sample 1 -1 -1 || true

# Provision only the package's directory; never change system preferences or
# relabel an existing store. On failure the daemon uses system rendering.
if [ "$DPKG_MAINTSCRIPT_ARCH" = iphoneos-arm64e ]; then
  /usr/libexec/flatglassdiag --prepare-mode-store ||
    printf '%s\n' 'FlatGlass: settings store not prepared; check installer output' >&2
fi

job="$prefix/Library/LaunchDaemons/local.lumid.flatglass.plist"
launchctl bootout user/foreground/local.lumid.flatglass >/dev/null 2>&1 ||
  launchctl bootout system/local.lumid.flatglass >/dev/null 2>&1 ||
  launchctl unload "$job" >/dev/null 2>&1 || true
if launchctl bootstrap system "$job"; then
  bootstrap_status=0
  fallback_status=-1
  launch_status=0
else
  bootstrap_status=$?
  if launchctl load "$job"; then
    fallback_status=0
    launch_status=0
  else
    fallback_status=$?
    launch_status=$fallback_status
  fi
fi
fgd_install_sample 2 "$bootstrap_status" "$fallback_status" || true
exit "$launch_status"
